# Copy to apps/api/.env and adjust. Required values fail fast at startup if missing.
NODE_ENV=development
PORT=4000
APP_ORIGIN="http://localhost:3000"

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/tero"

# Seeded administrator (used only by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-passphrase"
ADMIN_NAME="Family Admin"

# mysql = file bytes stored in the database (visible in Workbench); local = files under FILE_STORAGE_PATH
STORAGE_DRIVER=mysql
# with the mysql driver this folder only holds short-lived scratch files
FILE_STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB=500
VAULT_MAX_SIZE_MB=2000
FILE_RETENTION_DAYS=7
CLEANUP_INTERVAL_MINUTES=60

# At least 32 characters.
SESSION_SECRET="replace-with-a-random-string-of-32+-characters"
SESSION_TTL_HOURS=12

JOB_CONCURRENCY=2
# Safety limits for documents and images (memory protection)
MAX_PDF_PAGES=1500
MAX_RENDER_PAGES=200
MAX_IMAGE_PIXELS=120000000
VIDEO_TIMEOUT_MINUTES=60
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

SLOW_REQUEST_MS=500
SLOW_QUERY_MS=100
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
